{
  "name": "functions",
  "version": "3.0.0-f03.1",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/*.test.js test/f02/*.test.js test/f03/*.test.js",
    "test:f03": "node --test test/f03/*.test.js",
    "test:f03:live": "node --test --test-concurrency=1 test/live/*.test.js",
    "verify:f03": "npm run lint && npm run test:f03",
    "test:admin-deploy": "node scripts/verify-admin-tests.cjs",
    "verify:admin-deploy": "npm run lint && npm run test:admin-deploy",
    "verify": "npm run lint && npm test",
    "test:emulator": "node test/helpers/commands.js emulator-test",
    "test:admin-panel": "node test/admin_panel/run-emulator-tests.cjs",
    "test:admin-panel:performance": "node test/admin_panel/run-performance-emulator.cjs",
    "emulators:start": "node test/helpers/commands.js start",
    "fixtures:seed": "node test/helpers/commands.js seed",
    "fixtures:reset": "node test/helpers/commands.js reset",
    "serve": "npm run emulators:start",
    "start": "npm run emulators:start",
    "deploy": "node -e \"throw new Error('Use the reviewed named deploy commands in ../docs/backend-migration.md')\"",
    "logs": "firebase functions:log",
    "test_nf01": "node --test test/non_functional/TC-PH-NF01-unauthenticated.test.js",
    "test:nf01": "node --test test/non_functional/TC-PH-NF01-unauthenticated.test.js",
    "test:nf02": "node --test --test-name-pattern=\"verified employee session|client-supplied employee identity|revoked expired|disabled or permission-denied\" test/f03/order-employee-session.test.js test/non_functional/TC-PH-NF02-authorization-bypass.test.js",
    "test:nf04": "node --test test/non_functional/TC-PH-NF04-cross-pharmacy-access.test.js",
    "test:nf03": "node --test --test-name-pattern=\"TC-PH-NF03|hidden pharmacy rejects|hidden pharmacy can continue|disabled or permission-denied\" test/non_functional/TC-PH-NF03-hidden-pharmacy.test.js test/f03/insurance-resolution.test.js test/f03/order-employee-session.test.js",
    "test:nf05": "node --test test/non_functional/TC-PH-NF05-concurrent-last-quantity.test.js",
    "test:nf06": "node --test test/non_functional/TC-PH-NF06-duplicate-operation.test.js",
    "test:nf07": "node --test test/non_functional/TC-PH-NF07-refund-limit.test.js",
    "test:nf08": "node --test test/non_functional/TC-PH-NF08-purchase-atomicity.test.js",
    "test:nf12": "node --test --test-concurrency=1 test/non_functional/TC-PH-NF12-timeout-delivery-race.test.js",
    "test:nf17": "node --test --test-concurrency=1 test/non_functional/TC-PH-NF17-sensitive-operation-trace.test.js"
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase": "12.19.0",
    "firebase-functions-test": "^3.4.1",
    "firebase-tools": "15.3.1"
  },
  "private": true
}
