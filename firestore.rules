rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function adminDoc(){ return get(/databases/$(database)/documents/adminEmployees/$(request.auth.uid)); }
    function isAdmin(){ return signedIn() && request.auth.token.get('actorType', '') != 'pharmacy_employee' && exists(/databases/$(database)/documents/adminEmployees/$(request.auth.uid)) && adminDoc().data.isActive == true; }
    function can(key){ return isAdmin() && key in ['requests.view', 'audit.view', 'notifications.view', 'orders.view']; }
    function own(uid){ return signedIn() && request.auth.uid == uid; }
    function approvedOwner(uid) {
      let pharmacy = get(/databases/$(database)/documents/pharmacies/$(uid)).data;
      return own(uid) && request.auth.token.get('email_verified', false) == true
        && pharmacy.status == 'approved' && pharmacy.get('isActive', true) == true;
    }
    function employeeTokenFor(pharmacyId) {
      return signedIn()
        && request.auth.token.get('actorType', '') == 'pharmacy_employee'
        && request.auth.token.get('pharmacyId', '') == pharmacyId
        && request.auth.token.get('employeeId', '') is string
        && request.auth.token.get('employeeId', '').size() > 0
        && request.auth.token.get('sessionId', '') is string
        && request.auth.token.get('sessionId', '').size() > 0
        && request.auth.token.get('credentialVersion', -1) is int;
    }
    function employeeData(pharmacyId) {
      return get(/databases/$(database)/documents/pharmacies/$(pharmacyId)/employees/$(request.auth.token.get('employeeId', '_'))).data;
    }
    function employeeSessionData(pharmacyId) {
      return get(/databases/$(database)/documents/pharmacies/$(pharmacyId)/employeeSessions/$(request.auth.token.get('sessionId', '_'))).data;
    }
    function employeeSessionValid(pharmacyId) {
      let employee = employeeData(pharmacyId);
      let session = employeeSessionData(pharmacyId);
      let pharmacy = get(/databases/$(database)/documents/pharmacies/$(pharmacyId)).data;
      return employeeTokenFor(pharmacyId)
        && pharmacy.status == 'approved' && pharmacy.get('isActive', true) == true
        && employee.isActive == true
        && employee.credentialVersion == request.auth.token.get('credentialVersion', -1)
        && session.actorUid == request.auth.uid
        && session.pharmacyId == pharmacyId
        && session.employeeId == request.auth.token.get('employeeId', '')
        && session.credentialVersion == request.auth.token.get('credentialVersion', -1)
        && session.get('revokedAt', null) == null
        && session.expiresAt > request.time;
    }
    function employeeCan(pharmacyId, key) {
      let employee = employeeData(pharmacyId);
      let overrides = employee.get('permissionOverrides', {});
      let role = get(/databases/$(database)/documents/pharmacies/$(pharmacyId)/permissions/$(employee.roleId)).data;
      return employeeSessionValid(pharmacyId)
        && ((key in overrides && overrides[key] == true)
          || (!(key in overrides) && role.get('permissions', {}).get(key, false) == true));
    }
    function pharmacyMember(pharmacyId) {
      return approvedOwner(pharmacyId) || employeeSessionValid(pharmacyId);
    }
    function pharmacyCan(pharmacyId, key) {
      return approvedOwner(pharmacyId) || employeeCan(pharmacyId, key);
    }
    function selfEmployee(pharmacyId, employeeId) {
      return employeeSessionValid(pharmacyId)
        && request.auth.token.get('employeeId', '') == employeeId;
    }
    function pharmacyNotificationAccess(pharmacyId, type) {
      return approvedOwner(pharmacyId)
        || (type in ['newOrder', 'orderUpdate'] && employeeCan(pharmacyId, 'orders.view'))
        || (type == 'chatMessage' && employeeCan(pharmacyId, 'messages.view'))
        || (type in ['lowStock', 'nearExpiry', 'expiredStock'] && employeeCan(pharmacyId, 'inventory.view'));
    }
    function pharmacyReadAccess(pharmacyId, collection) {
      return approvedOwner(pharmacyId)
        || (collection in ['medicines'] && employeeCan(pharmacyId, 'inventory.view'))
        || (collection in ['suppliers'] && employeeCan(pharmacyId, 'suppliers.view'))
        || (collection in ['insurance_companies', 'insurance_collections'] && employeeCan(pharmacyId, 'insurance.view'))
        || (collection in ['purchase_invoices'] && employeeCan(pharmacyId, 'purchases.view'))
        || (collection in ['shifts', 'shift_states', 'dailyClosings'] && employeeCan(pharmacyId, 'shifts.view'))
        || (collection in ['expenses', 'salary_payments'] && employeeCan(pharmacyId, 'finance.view'))
        || (collection in ['notifications'] && employeeCan(pharmacyId, 'dashboard.view'))
        || (collection in ['settings'] && employeeCan(pharmacyId, 'settings.view'))
        || (collection in ['audit_logs'] && employeeSessionValid(pharmacyId))
        || (collection in ['roles', 'permissions'] && employeeCan(pharmacyId, 'employees.view'));
    }
    function pharmacyWriteAccess(pharmacyId, collection) {
      return approvedOwner(pharmacyId)
        || (collection in ['medicines'] && (employeeCan(pharmacyId, 'inventory.create')
          || employeeCan(pharmacyId, 'inventory.update') || employeeCan(pharmacyId, 'inventory.delete')))
        || (collection in ['suppliers'] && (employeeCan(pharmacyId, 'suppliers.create')
          || employeeCan(pharmacyId, 'suppliers.update') || employeeCan(pharmacyId, 'suppliers.delete')))
        || (collection in ['insurance_companies'] && (employeeCan(pharmacyId, 'insurance.create')
          || employeeCan(pharmacyId, 'insurance.update') || employeeCan(pharmacyId, 'insurance.delete')))
        || (collection in ['purchase_invoices'] && (employeeCan(pharmacyId, 'purchases.create')
          || employeeCan(pharmacyId, 'purchases.payment') || employeeCan(pharmacyId, 'purchases.delete')))
        || (collection in ['shifts', 'shift_states', 'dailyClosings'] && (employeeCan(pharmacyId, 'shifts.open')
          || employeeCan(pharmacyId, 'shifts.close')))
        || (collection in ['expenses', 'salary_payments'] && employeeCan(pharmacyId, 'finance.view'))
        || (collection in ['notifications'] && employeeCan(pharmacyId, 'dashboard.view'))
        || (collection in ['settings'] && employeeCan(pharmacyId, 'settings.update'))
        || (collection in ['audit_logs'] && employeeSessionValid(pharmacyId))
        || (collection in ['roles', 'permissions'] && employeeCan(pharmacyId, 'roles.manage'));
    }
    function ownsSearchIndex(data, id) {
      return data.pharmacyId is string && data.medicineId is string
        && pharmacyCan(data.pharmacyId, 'inventory.update') && data.medicineId.size() > 0
        && id == data.pharmacyId + '_' + data.medicineId;
    }
    function chatParticipant(data) {
      return signedIn()
        && (data.get('userId', '') == request.auth.uid || pharmacyCan(data.get('pharmacyId', '_'), 'messages.view'));
    }
    function orderParticipant(data) {
      return signedIn() && (data.user.userId == request.auth.uid
        || pharmacyCan(data.pharmacy.pharmacyId, 'orders.view'));
    }
    function chatParticipantAfter(chatId) {
      return chatParticipant(
        getAfter(/databases/$(database)/documents/chats/$(chatId)).data
      );
    }
    function chatParticipantById(chatId) {
      return chatParticipant(
        get(/databases/$(database)/documents/chats/$(chatId)).data
      );
    }
    function missingDeterministicOrderChat(chatId) {
      return signedIn()
        && chatId.matches('order_.+')
        && !exists(/databases/$(database)/documents/chats/$(chatId));
    }
    function chatOrderOpen(chatId) {
      let chat = getAfter(/databases/$(database)/documents/chats/$(chatId)).data;
      return chat.orderId is string
        && existsAfter(/databases/$(database)/documents/orders/$(chat.orderId))
        && !(getAfter(/databases/$(database)/documents/orders/$(chat.orderId)).data.status
          in ['completed', 'cancelled', 'rejected', 'notCollected']);
    }
    function directSale(data, pharmacyId) {
      return data.get('source', '') == 'pos'
        && data.get('orderId', null) in [null, '']
        && data.get('sourceOrderId', null) in [null, '']
        && (data.get('refSaleId', null) in [null, '']
          || getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/sales/$(data.refSaleId)).data.source == 'pos');
    }
    function directFinancialEntry(data, pharmacyId) {
      return (data.get('metadata', null) == null
          || !(data.metadata.get('source', '') in ['order', 'orderRefund']))
        && (data.get('referenceCollection', '') != 'sales'
          || getAfter(/databases/$(database)/documents/pharmacies/$(pharmacyId)/sales/$(data.referenceId)).data.source == 'pos');
    }

    match /adminEmployees/{uid} {
      allow read: if own(uid);
      allow create, update: if false;
      allow delete: if false;
    }
    match /adminAuditLogs/{id} {
      allow read: if can('audit.view');
      allow create: if false;
      allow update, delete: if false;
    }
    match /adminBroadcastNotifications/{id} {
      allow read: if can('notifications.view');
      allow create, update: if false;
      allow delete: if false;
    }
    match /pharmacyRequests/{id} {
      allow read: if own(id) || can('requests.view');
      allow write: if false;
      match /{collection}/{item} {
        allow read: if collection in ['versions', 'history', 'notifications'] && (own(id) || can('requests.view'));
        allow update: if collection == 'notifications' && own(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
          && request.resource.data.isRead == true && request.resource.data.readAt == request.time;
        allow create, delete: if false;
      }
    }
    match /pharmacies/{id} {
      allow read: if signedIn() && !isAdmin();
      allow create: if false;
      allow update: if (employeeCan(id, 'settings.update')
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'isBlocked', 'isActive', 'approvedDate', 'approvedBy',
            'sourceRequestId', 'id', 'ownerUid', 'visibilityRevision', 'visibilityReason', 'visibilityChangedAt', 'visibilityChangedBy'
          ]))
        || (approvedOwner(id) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'isBlocked', 'isActive', 'approvedDate', 'approvedBy', 'sourceRequestId', 'id', 'ownerUid',
          'visibilityRevision', 'visibilityReason', 'visibilityChangedAt', 'visibilityChangedBy'
        ]));
      allow delete: if false;
      match /settings/businessHours {
        allow read: if signedIn();
        allow write: if pharmacyCan(id, 'settings.update');
      }
      match /employees/{employeeId} {
        allow read: if approvedOwner(id) || selfEmployee(id, employeeId)
          || employeeCan(id, 'employees.view');
        // Account, role, active-state and override mutations are callable-only.
        allow create, update, delete: if false;
      }
      match /notifications/{notificationId} {
        allow read: if pharmacyNotificationAccess(id, resource.data.type);
        allow update: if pharmacyNotificationAccess(id, resource.data.type)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'isDeleted'])
          && request.resource.data.isRead is bool && request.resource.data.isDeleted is bool
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readAt']) || request.resource.data.readAt == request.time);
        allow create, delete: if false;
      }
      match /stockAlertStates/{stateId} {
        allow read, write: if false;
      }
      match /purchase_submission_keys/{submissionId} {
        allow read, write: if false;
      }
      match /quarantinedReturns/{returnId} {
        allow read: if pharmacyCan(id, 'inventory.view') || pharmacyCan(id, 'sales.refund') || pharmacyCan(id, 'finance.view');
        allow write: if false;
        match /dispositions/{decisionId} {
          allow read: if pharmacyCan(id, 'inventory.view') || pharmacyCan(id, 'sales.refund');
          allow write: if false;
        }
      }
      match /roles/{roleId} {
        allow get: if approvedOwner(id) || (employeeSessionValid(id)
          && employeeData(id).roleId == roleId) || employeeCan(id, 'employees.view');
        allow list: if approvedOwner(id) || employeeCan(id, 'employees.view');
        allow write: if false;
      }
      match /permissions/{roleId} {
        allow get: if approvedOwner(id) || (employeeSessionValid(id)
          && employeeData(id).roleId == roleId) || employeeCan(id, 'employees.view');
        allow list: if approvedOwner(id) || employeeCan(id, 'employees.view');
        allow write: if false;
      }
      match /employeeCredentials/{employeeId} {
        allow read, write: if false;
      }
      match /employeeUsernames/{usernameId} {
        allow read, write: if false;
      }
      match /employeeSessions/{sessionId} {
        allow read, write: if false;
      }
      match /employeeLoginAttempts/{attemptId} {
        allow read, write: if false;
      }
      match /sales/{saleId} {
        allow read: if pharmacyCan(id, 'sales.view') || pharmacyCan(id, 'sales.create') || pharmacyCan(id, 'finance.view');
        allow create, update, delete: if false;
        match /returns/{returnId} {
          allow read: if pharmacyCan(id, 'sales.view') || pharmacyCan(id, 'sales.refund');
          allow write: if false;
        }
      }
      match /financial_transactions/{entryId} {
        allow read: if pharmacyCan(id, 'finance.view');
        allow write: if false;
      }
      match /payroll_periods/{periodId} {
        allow read: if pharmacyCan(id, 'finance.view') || pharmacyCan(id, 'finance.payroll.view');
        allow write: if false;
      }
      match /salary_payments/{paymentId} {
        allow read: if pharmacyCan(id, 'finance.view') || pharmacyCan(id, 'finance.payroll.view');
        allow write: if false;
      }
      match /shifts/{shiftId} {
        allow read: if pharmacyCan(id, 'shifts.view') || pharmacyCan(id, 'sales.create') || pharmacyCan(id, 'finance.view');
        allow write: if false;
      }
      match /shift_states/{actorKey} {
        allow read: if pharmacyCan(id, 'shifts.view') || pharmacyCan(id, 'sales.create');
        allow write: if false;
      }
      match /financial_operations/{operationId} {
        allow read, write: if false;
      }
      match /insurance_ledger/{entryId} {
        allow read: if pharmacyCan(id, 'insurance.view') || pharmacyCan(id, 'finance.view');
        allow write: if false;
      }
      match /insurance_collections/{entryId} {
        allow read: if pharmacyCan(id, 'insurance.view') || pharmacyCan(id, 'finance.view');
        allow write: if false;
      }
      match /audit_logs/{entryId} {
        allow read: if pharmacyMember(id);
        allow create: if pharmacyMember(id) && !entryId.matches('finance-.*');
        allow update, delete: if false;
      }
      match /medicines/{medicineId}/{sub=**} {
        allow read: if pharmacyCan(id, 'inventory.view') || pharmacyCan(id, 'purchases.create') || pharmacyCan(id, 'sales.create') || pharmacyCan(id, 'finance.view');
        allow write: if false;
      }
      match /purchase_invoices/{invoiceId}/{sub=**} {
        allow read: if pharmacyCan(id, 'purchases.view') || pharmacyCan(id, 'purchases.create') || pharmacyCan(id, 'purchases.payment') || pharmacyCan(id, 'finance.view');
        allow write: if false;
      }
      match /suppliers/{supplierId} {
        allow read: if pharmacyCan(id, 'suppliers.view') || pharmacyCan(id, 'purchases.view') || pharmacyCan(id, 'finance.view');
        allow write: if false;
      }
      match /insurance_companies/{companyId} {
        allow read: if pharmacyCan(id, 'insurance.view') || pharmacyCan(id, 'sales.create') || pharmacyCan(id, 'finance.view');
        allow write: if false;
      }
      match /{collection}/{sub=**} {
        allow read: if pharmacyReadAccess(id, collection)
          && !(collection in [
          'notifications', 'stockAlertStates', 'purchase_submission_keys',
          'employeeCredentials', 'employeeUsernames', 'employeeSessions',
          'employeeLoginAttempts'
        ]);
        allow write: if pharmacyWriteAccess(id, collection)
          && !(collection in [
            'notifications', 'stockAlertStates', 'purchase_submission_keys',
            'sales', 'financial_transactions', 'financial_operations', 'insurance_ledger',
            'insurance_collections', 'purchase_invoices', 'medicines', 'suppliers', 'insurance_companies',
            'shifts', 'shift_states', 'expenses', 'salary_payments', 'audit_logs', 'insurance_codes', 'purchase_counters', 'quarantinedReturns', 'employees',
            'employeeCredentials', 'employeeUsernames', 'employeeSessions',
            'employeeLoginAttempts', 'roles', 'permissions', 'payroll_periods'
          ]);
      }
    }
    match /users/{uid} {
      allow read: if own(uid) && !isAdmin();
      allow create: if own(uid);
      allow update: if own(uid) && !isAdmin();
      allow delete: if own(uid);
      match /insurances/{insuranceId} {
        allow read, delete: if own(uid) && !isAdmin();
        allow create: if own(uid) && !isAdmin()
          && request.resource.data.beneficiaryId == insuranceId
          && request.resource.data.beneficiaryType in ['self', 'family']
          && request.resource.data.policyNumber is string
          && request.resource.data.policyNumber.size() > 0
          && request.resource.data.companyCode is string
          && request.resource.data.companyCode.size() > 0
          && request.resource.data.coveredMemberIds == [insuranceId];
        allow update: if own(uid) && !isAdmin()
          && resource.data.beneficiaryId == insuranceId
          && request.resource.data.beneficiaryId == insuranceId
          && request.resource.data.beneficiaryType == resource.data.beneficiaryType
          && request.resource.data.policyNumber is string
          && request.resource.data.policyNumber.size() > 0
          && request.resource.data.companyCode is string
          && request.resource.data.companyCode.size() > 0
          && request.resource.data.coveredMemberIds == [insuranceId];
      }
      match /{collection}/{sub=**} {
        allow read: if own(uid) && !isAdmin();
        allow write: if own(uid)
          && !(collection in ['orderIncidents', 'insurances']);
      }
    }
    match /orders/{id} {
      allow read: if !isAdmin() && orderParticipant(resource.data);
      allow create: if false;
      allow update: if signedIn()
        && (resource.data.user.userId == request.auth.uid
          || pharmacyCan(resource.data.pharmacy.pharmacyId, 'orders.update_status'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userNote','pharmacyNote','chatId','updatedAt']);
      allow delete: if false;
      match /{sub=**}{
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/orders/$(id)).data.user.userId == request.auth.uid
            || pharmacyCan(get(/databases/$(database)/documents/orders/$(id)).data.pharmacy.pharmacyId, 'orders.view'));
        allow write: if false;
      }
    }
    match /chats/{chatId} {
      // The clients use a transaction to guard deterministic first creation.
      // A get of the not-yet-created id must be allowed; list queries and every
      // existing document remain participant-only.
      allow get: if missingDeterministicOrderChat(chatId)
        || chatParticipant(resource.data);
      allow list: if chatParticipant(resource.data);
      allow create: if chatParticipant(request.resource.data)
        && request.resource.data.orderId is string
        && chatId == 'order_' + request.resource.data.orderId
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.user.userId
          == request.resource.data.userId
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.pharmacy.pharmacyId
          == request.resource.data.pharmacyId;
      allow update: if chatParticipant(resource.data)
        && chatParticipant(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.pharmacyId == resource.data.pharmacyId
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageType', 'lastMessageTime', 'updatedAt',
          'userUnreadCount', 'pharmacyUnreadCount', 'pharmacyIsOnline'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if chatParticipantById(chatId);
        allow create: if chatParticipantAfter(chatId)
          && chatOrderOpen(chatId)
          && (request.resource.data.senderId == request.auth.uid
            || (messageId == 'conversation_created'
              && request.resource.data.senderId == 'system'
              && request.resource.data.senderType == 'system'));
        allow update: if chatParticipantById(chatId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'status']);
        allow delete: if false;
      }
    }
    match /orderOperations/{id} { allow read, write: if false; }
    match /adminOrderSummaries/{id} {
      allow read: if can('orders.view');
      allow write: if false;
    }
    match /complaints/{id} {
      allow create: if signedIn();
      allow read: if signedIn() && !isAdmin() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
    match /medicine_search_index/{id} {
      allow read: if true;
      allow create: if ownsSearchIndex(request.resource.data, id)
        && exists(/databases/$(database)/documents/pharmacies/$(request.resource.data.pharmacyId)/medicines/$(request.resource.data.medicineId));
      allow update: if ownsSearchIndex(resource.data, id)
        && ownsSearchIndex(request.resource.data, id)
        && exists(/databases/$(database)/documents/pharmacies/$(request.resource.data.pharmacyId)/medicines/$(request.resource.data.medicineId));
      allow delete: if ownsSearchIndex(resource.data, id);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
